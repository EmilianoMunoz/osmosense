# Google Earth Engine
GEE_PROJECT_ID=tu-proyecto-gee

# Entorno cloud
APP_ENV=production
ENABLE_LOCAL_FALLBACK=false
ENABLE_QUICK_LOGIN=false

# API/dashboard
API_BASE_URL=http://IP_O_DNS_DE_LA_VM:8000
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501

# PostGIS operativo
DATABASE_URL=postgresql://usuario:password@host:5432/estres

# Auth
# Usar un valor real de al menos 32 caracteres; no versionarlo.
AUTH_SECRET=reemplazar-por-secreto-largo-de-produccion
AUTH_TOKEN_TTL_SECONDS=28800

# Pipeline
PIPELINE_MODE=cloud
