[Unit]
Description=OSMOSENSE hydric pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=osmosense
Group=osmosense
WorkingDirectory=/opt/osmosense
EnvironmentFile=/opt/osmosense/.env
ExecStart=/opt/osmosense/venv/bin/python backend/scripts/pipeline/run_pipeline_hidrico.py --mode cloud --update-sentinel --update-recent-window --parcel-source postgis --skip-if-no-new-date --load-postgis
