[Unit]
Description=OSMOSENSE PostGIS backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=osmosense
Group=osmosense
SupplementaryGroups=docker
WorkingDirectory=/opt/osmosense
EnvironmentFile=/opt/osmosense/.env
ExecStart=/opt/osmosense/deployment/scripts/backup_postgis.sh
