[Unit]
Description=OSMOSENSE FastAPI backend
After=network-online.target postgresql.service docker.service
Wants=network-online.target

[Service]
Type=simple
User=osmosense
Group=osmosense
WorkingDirectory=/opt/osmosense
EnvironmentFile=/opt/osmosense/.env
ExecStart=/opt/osmosense/venv/bin/uvicorn backend.app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
